{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5200
    },
    {
      "name": "pages-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web/app && PAGES_BASE=/pixel-arena/ ../node_modules/.bin/vite preview --port 5300 --strictPort"
      ],
      "port": 5300
    }
  ]
}
